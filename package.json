{
  "name": "dsh-workspace-git-status",
  "version": "0.3.0",
  "description": "DeepSeek Harness plugin: each workspace's Git status in the left sidebar.",
  "type": "module",
  "license": "MIT",
  "author": "yuhaoxin",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yuhaoxin/dsh-workspace-git-status.git"
  },
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  }
}
